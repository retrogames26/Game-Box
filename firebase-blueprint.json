{
  "entities": {
    "PlayerProfile": {
      "title": "PlayerProfile",
      "description": "Browser player record with username and stats",
      "type": "object",
      "properties": {
        "playerId": { "type": "string", "maxLength": 128 },
        "username": { "type": "string", "maxLength": 24, "minLength": 2 },
        "avatarId": { "type": "string", "maxLength": 32 },
        "gamesPlayed": { "type": "number" },
        "totalWins": { "type": "number" },
        "totalScore": { "type": "number" },
        "highScores": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["playerId", "username"]
    },
    "ScoreSubmission": {
      "title": "ScoreSubmission",
      "description": "Game leaderboard score record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "playerId": { "type": "string", "maxLength": 128 },
        "username": { "type": "string", "maxLength": 24 },
        "gameId": { "type": "string", "maxLength": 32 },
        "score": { "type": "number" },
        "mode": { "type": "string", "maxLength": 24 },
        "result": { "type": "string", "maxLength": 16 },
        "detail": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["playerId", "username", "gameId", "score"]
    },
    "MatchSubmission": {
      "title": "MatchSubmission",
      "description": "Head-to-head match summary against AI",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "gameId": { "type": "string", "maxLength": 32 },
        "playerId": { "type": "string", "maxLength": 128 },
        "username": { "type": "string", "maxLength": 24 },
        "mode": { "type": "string", "maxLength": 24 },
        "playerScore": { "type": "number" },
        "aiScore": { "type": "number" },
        "winner": { "type": "string", "maxLength": 16 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["gameId", "playerId", "username", "playerScore"]
    },
    "PokerRoom": {
      "title": "PokerRoom",
      "description": "Real-time multiplayer poker room",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "roomCode": { "type": "string", "maxLength": 16 },
        "hostPlayerId": { "type": "string", "maxLength": 128 },
        "players": { "type": "array" },
        "communityCards": { "type": "array" },
        "pot": { "type": "number" },
        "currentBet": { "type": "number" },
        "activeTurn": { "type": "number" },
        "phase": { "type": "string", "maxLength": 24 },
        "isStarted": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["roomCode", "hostPlayerId"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Admin score moderation audit log",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "adminEmail": { "type": "string", "maxLength": 128 },
        "adminUid": { "type": "string", "maxLength": 128 },
        "action": { "type": "string", "maxLength": 32 },
        "targetScoreId": { "type": "string", "maxLength": 128 },
        "targetUsername": { "type": "string", "maxLength": 24 },
        "targetGameId": { "type": "string", "maxLength": 32 },
        "targetScore": { "type": "number" },
        "reason": { "type": "string", "maxLength": 255 },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["adminUid", "action", "targetScoreId"]
    }
  },
  "firestore": {
    "/players/{playerId}": {
      "schema": { "$ref": "#/entities/PlayerProfile" },
      "description": "Browser player records"
    },
    "/scores/{scoreId}": {
      "schema": { "$ref": "#/entities/ScoreSubmission" },
      "description": "Leaderboard scores"
    },
    "/matches/{matchId}": {
      "schema": { "$ref": "#/entities/MatchSubmission" },
      "description": "Match summaries"
    },
    "/poker_rooms/{roomId}": {
      "schema": { "$ref": "#/entities/PokerRoom" },
      "description": "Live multiplayer poker tables"
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Protected administrator moderation audit records"
    }
  }
}

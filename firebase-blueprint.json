{
  "entities": {
    "PlayerProfile": {
      "title": "PlayerProfile",
      "description": "Browser player record with username and stats",
      "type": "object",
      "properties": {
        "playerId": {
          "type": "string",
          "description": "Unique browser installation ID",
          "maxLength": 128
        },
        "username": {
          "type": "string",
          "description": "Player gamer tag",
          "maxLength": 24,
          "minLength": 2,
          "pattern": "^[a-zA-Z0-9_]{2,24}$"
        },
        "avatarId": {
          "type": "string",
          "description": "Selected avatar icon",
          "maxLength": 32
        },
        "gamesPlayed": {
          "type": "number",
          "description": "Total games played"
        },
        "totalWins": {
          "type": "number",
          "description": "Total wins in VS AI matches"
        },
        "totalScore": {
          "type": "number",
          "description": "Cumulative total score"
        },
        "highScores": {
          "type": "object",
          "description": "Best scores per game"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["playerId", "username"]
    },
    "ScoreSubmission": {
      "title": "ScoreSubmission",
      "description": "Game leaderboard score record",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Score ID",
          "maxLength": 128
        },
        "playerId": {
          "type": "string",
          "description": "Player ID",
          "maxLength": 128
        },
        "username": {
          "type": "string",
          "description": "Player username",
          "maxLength": 24
        },
        "gameId": {
          "type": "string",
          "description": "Game ID (claw, pacmaze, shooter, bowling, pool, poker)",
          "maxLength": 32
        },
        "score": {
          "type": "number",
          "description": "Numeric score achieved"
        },
        "mode": {
          "type": "string",
          "description": "Game mode: solo or versus_ai",
          "maxLength": 24
        },
        "result": {
          "type": "string",
          "description": "Result: win, loss, draw, solo",
          "maxLength": 16
        },
        "detail": {
          "type": "string",
          "description": "Game details (frames, strikes, hands, etc.)",
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Submission timestamp"
        }
      },
      "required": ["playerId", "username", "gameId", "score"]
    },
    "MatchSubmission": {
      "title": "MatchSubmission",
      "description": "Head-to-head match summary against AI",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Match ID",
          "maxLength": 128
        },
        "gameId": {
          "type": "string",
          "description": "Game ID",
          "maxLength": 32
        },
        "playerId": {
          "type": "string",
          "description": "Player ID",
          "maxLength": 128
        },
        "username": {
          "type": "string",
          "description": "Player username",
          "maxLength": 24
        },
        "mode": {
          "type": "string",
          "description": "Match mode",
          "maxLength": 24
        },
        "playerScore": {
          "type": "number",
          "description": "Player score"
        },
        "aiScore": {
          "type": "number",
          "description": "AI score"
        },
        "winner": {
          "type": "string",
          "description": "Winner result: player, ai, draw, solo",
          "maxLength": 16
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Match timestamp"
        }
      },
      "required": ["gameId", "playerId", "username", "playerScore"]
    }
  },
  "firestore": {
    "/players/{playerId}": {
      "schema": { "$ref": "#/entities/PlayerProfile" },
      "description": "Browser player profile"
    },
    "/scores/{scoreId}": {
      "schema": { "$ref": "#/entities/ScoreSubmission" },
      "description": "Public leaderboard scores"
    },
    "/matches/{matchId}": {
      "schema": { "$ref": "#/entities/MatchSubmission" },
      "description": "Completed match results"
    }
  }
}

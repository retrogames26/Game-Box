rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUsername(uname) {
      return uname is string && uname.size() >= 2 && uname.size() <= 24 && uname.matches('^[a-zA-Z0-9_]{2,24}$');
    }

    function isValidGameId(gid) {
      return gid in ['claw', 'pacmaze', 'shooter', 'bowling', 'pool', 'poker'];
    }

    // Player Records
    match /players/{playerId} {
      allow get, list: if true;
      allow create, update: if isValidId(playerId) &&
        incoming().keys().hasAll(['playerId', 'username']) &&
        incoming().keys().hasOnly(['playerId', 'username', 'avatarId', 'gamesPlayed', 'totalWins', 'totalScore', 'highScores', 'createdAt', 'updatedAt']) &&
        incoming().playerId is string && incoming().playerId.size() <= 128 &&
        isValidUsername(incoming().username) &&
        (!('avatarId' in incoming()) || (incoming().avatarId is string && incoming().avatarId.size() <= 32)) &&
        (!('gamesPlayed' in incoming()) || (incoming().gamesPlayed is number && incoming().gamesPlayed >= 0)) &&
        (!('totalWins' in incoming()) || (incoming().totalWins is number && incoming().totalWins >= 0)) &&
        (!('totalScore' in incoming()) || (incoming().totalScore is number && incoming().totalScore >= 0)) &&
        (!('highScores' in incoming()) || incoming().highScores is map);
      allow delete: if false;
    }

    // Global Scores
    match /scores/{scoreId} {
      allow get, list: if true;
      allow create: if isValidId(scoreId) &&
        incoming().keys().hasAll(['playerId', 'username', 'gameId', 'score']) &&
        incoming().keys().hasOnly(['id', 'playerId', 'username', 'gameId', 'score', 'mode', 'result', 'detail', 'createdAt']) &&
        incoming().playerId is string && incoming().playerId.size() <= 128 &&
        isValidUsername(incoming().username) &&
        isValidGameId(incoming().gameId) &&
        incoming().score is number && incoming().score >= 0 && incoming().score <= 10000000 &&
        (!('mode' in incoming()) || (incoming().mode is string && incoming().mode.size() <= 24)) &&
        (!('result' in incoming()) || (incoming().result is string && incoming().result.size() <= 16)) &&
        (!('detail' in incoming()) || (incoming().detail is string && incoming().detail.size() <= 120));
      allow update, delete: if false;
    }

    // Match Summaries
    match /matches/{matchId} {
      allow get, list: if true;
      allow create: if isValidId(matchId) &&
        incoming().keys().hasAll(['gameId', 'playerId', 'username', 'playerScore']) &&
        incoming().keys().hasOnly(['id', 'gameId', 'playerId', 'username', 'mode', 'playerScore', 'aiScore', 'winner', 'createdAt']) &&
        isValidGameId(incoming().gameId) &&
        incoming().playerId is string && incoming().playerId.size() <= 128 &&
        isValidUsername(incoming().username) &&
        incoming().playerScore is number && incoming().playerScore >= 0 &&
        (!('aiScore' in incoming()) || (incoming().aiScore is number && incoming().aiScore >= 0)) &&
        (!('winner' in incoming()) || (incoming().winner is string && incoming().winner.size() <= 16));
      allow update, delete: if false;
    }
  }
}
